{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "uSeeker",
  "version": "2.5.0",
  "identifier": "com.useeker.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "uSeeker \u2014 Pelacak Lamaran Kerja",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM1NUZBMzk3MDM0MkUzOTYKUldTVzQwSURsNk5mTlI3UDlIVlRUR01nb0ZCVHBhWVZuOVRBSmVDald6eEtmRG1sY0R1SVdhWjQK",
      "endpoints": [
        "https://github.com/novrizal-triananda/uSeeker/releases/latest/download/latest.json"
      ]
    }
  }
}
