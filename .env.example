# uSeeker — Environment Configuration
# Copy to .env and fill in your values.

# ── AI Provider ──────────────────────────────────────────
# Works with any OpenAI-compatible API (Deepseek, OpenRouter, local, etc.)
# Leave AI_API_KEY blank to disable AI features.
#
# Examples:
#   Deepseek:    AI_BASE_URL=https://api.deepseek.com,      AI_MODEL=deepseek-chat
#   OpenRouter:  AI_BASE_URL=https://openrouter.ai/api/v1,  AI_MODEL=anthropic/claude-3.5-sonnet
#   Local:       AI_BASE_URL=http://localhost:8080/v1,       AI_MODEL=llama-3-8b

AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
AI_API_KEY=your-api-key-here

# ── Search Provider ──────────────────────────────────────
# Multi-provider search with auto-fallback:
#   1. DuckDuckGo (free, unlimited — blocked in Indonesia)
#   2. Brave Search API (free 2000/month — recommended for Indonesia)
#   3. Bing Web Search API (free 1000/month)
#
# Get free API keys:
#   Brave:  https://brave.com/search/api/ (free tier, no credit card)
#   Bing:   https://www.microsoft.com/en-us/bing/apis/bing-web-search-api
#
# At least one API key is recommended for users in Indonesia.

BRAVE_API_KEY=
BING_API_KEY=

# ── Server ───────────────────────────────────────────────
USEEKER_API_PORT=8787
USEEKER_ALLOW_CLOUD_AI=true
